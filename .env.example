# === General ===
TZ=UTC
LOG_LEVEL=INFO
DRY_RUN=1
WEBHOOK_PORT=5099

# === unmonitor: time-delayed monitoring (Sonarr/Radarr) ===
SLEEP_MINUTES=30
DELAY_MINUTES=60
AUTO_TAG_NAME=auto-unmonitored
IGNORE_TAG_NAME=ignore
SKIP_IF_FILE=1

ENABLE_RADARR=1
RADARR_URL=http://localhost:7878
RADARR_API_KEY=YOUR_KEY
PREFERRED_RELEASE=either
IGNORE_INCINEMAS=0
RADARR_REMONITOR_WINDOW_DAYS=30

ENABLE_SONARR=1
SONARR_URL=http://localhost:8989
SONARR_API_KEY=YOUR_KEY
SONARR_REMONITOR_WINDOW_DAYS=14
SEASON_PACK_MODE=0
SEASON_PACK_MODE_TAG=season-pack

# === prefetch: predictive episode fetching (Sonarr + media server) ===
# Reuses SONARR_URL / SONARR_API_KEY above.
ENABLE_PREFETCH=0

MEDIA_SERVER_TYPE=jellyfin
MEDIA_SERVER_URL=http://localhost:8096
MEDIA_SERVER_API_KEY=YOUR_KEY
# MEDIA_SERVER_USERS=John,12345
# MEDIA_SERVER_LIBRARIES=TV Shows,Anime

PREFETCH_INTERVAL=900
PREFETCH_NUM=2
PREFETCH_REQUEST_SEASONS=1
PREFETCH_APPEND_TO_QUEUE=0
PREFETCH_CHECK_AIRED=0
PREFETCH_CONNECTION_RETRIES=6
# PREFETCH_EXCLUDE_TAG=no-prefetch
